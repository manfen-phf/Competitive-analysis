generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppUser {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  // SQLite/D1 has no native enum support. The migration constrains this to AppRole values.
  role         String
  city         String?
  bdName       String?
  sessions     AppSession[]
  createdCollections CollectionTask[]

  @@index([role, city])
  @@index([bdName])
}

model AppSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AppBootstrap {
  id        String   @id
  ownerToken String
  createdAt DateTime @default(now())
}

model MasterDataVersion {
  id          String               @id @default(cuid())
  importedAt  DateTime             @default(now())
  isActive    Boolean              @default(true)
  assignments MerchantAssignment[]

  @@index([isActive, importedAt])
}

model MerchantAssignment {
  id            String            @id @default(cuid())
  merchantId    String
  merchantName  String
  city          String
  bdName        String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  versionId     String
  version       MasterDataVersion @relation(fields: [versionId], references: [id])

  @@index([city, merchantId])
  @@index([merchantId, effectiveFrom])
}

model CollectionTask {
  id                  String   @id @default(cuid())
  merchantId          String
  merchantName        String
  city                String
  bdName              String
  originalDeliveryFee Float
  createdByUserId     String?
  // SQLite/D1 stores states as checked text rather than native enums.
  status              String   @default("DRAFT")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdByUser       AppUser? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  uploads             Upload[]

  @@index([merchantId, createdAt])
  @@index([city, bdName, status])
  @@index([createdByUserId])
}

model Upload {
  id            String              @id @default(cuid())
  // New V1 screenshots use an R2 key. Historical D1 rows may only have inline bytes.
  imageFileId   String?
  legacyImageData Bytes?
  imageMimeType String
  imageHash     String
  imageAccessToken String         @unique
  uploadedAt DateTime            @default(now())
  order      OrderRecord?
  collectionId String
  collection   CollectionTask @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  // Historical uploads can lack platform attribution; new images must provide one at the API boundary.
  platform    String?
  recognitionStatus String @default("PENDING")
  recognitionResult String?
  storageReference String?

  @@index([collectionId, platform])
  @@index([imageHash])
  @@index([recognitionStatus])
  failure    RecognitionFailure?
}

model ImageHashReservation {
  imageHash String @id
  createdAt DateTime @default(now())
}

model OrderRecord {
  id          String @id @default(cuid())
  uploadId    String @unique
  upload      Upload @relation(fields: [uploadId], references: [id])
  orderNumber String? @unique
  platform    String
  merchantId  String
  merchantName String @default("")
  city        String
  bdName      String
  uploadedAt  DateTime @default(now())
  // 0008 added this D1 column without a NOT NULL constraint; keep the ORM contract exact.
  updatedAt   DateTime? @updatedAt
  dishPrice Float
  packagingFee Float
  merchantActivity Float @default(0)
  platformRedPacket Float
  platformRedPacketMerchantShare Float @default(0)
  originalDeliveryFee Float
  deliveryFeeReduction Float
  paidDeliveryFee Float
  merchantSettlementAmount Float
  userPaidAmount Float
  otherPromotion Float
  technicalServiceFee Float
  deliveryServiceFee Float
  merchantRate Float
  audits OrderAuditLog[]

  @@index([city, uploadedAt])
  @@index([merchantId, uploadedAt])
}

model OrderAuditLog {
  id            String      @id @default(cuid())
  orderId       String
  order         OrderRecord @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUserId   String
  actorUsername String
  beforeJson    String
  afterJson     String
  createdAt     DateTime    @default(now())

  @@index([orderId, createdAt])
}

model RecognitionFailure {
  id        String @id @default(cuid())
  uploadId  String @unique
  upload    Upload @relation(fields: [uploadId], references: [id])
  reason    String
  createdAt DateTime @default(now())
}
