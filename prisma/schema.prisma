generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppUser {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  // SQLite/D1 has no native enum support. The migration constrains this to AppRole values.
  role         String
  city         String?
  bdName       String?
  sessions     AppSession[]

  @@index([role, city])
  @@index([bdName])
}

model AppSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AppBootstrap {
  id        String   @id
  ownerToken String
  createdAt DateTime @default(now())
}

model MasterDataVersion {
  id          String               @id @default(cuid())
  importedAt  DateTime             @default(now())
  isActive    Boolean              @default(true)
  assignments MerchantAssignment[]

  @@index([isActive, importedAt])
}

model MerchantAssignment {
  id            String            @id @default(cuid())
  merchantId    String
  merchantName  String
  city          String
  bdName        String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  versionId     String
  version       MasterDataVersion @relation(fields: [versionId], references: [id])

  @@index([city, merchantId])
  @@index([merchantId, effectiveFrom])
}

model Upload {
  id            String              @id @default(cuid())
  imageData     Bytes
  imageMimeType String
  imageHash     String              @unique
  imageAccessToken String         @unique
  uploadedAt DateTime            @default(now())
  order      OrderRecord?
  failure    RecognitionFailure?
}

model OrderRecord {
  id          String @id @default(cuid())
  uploadId    String @unique
  upload      Upload @relation(fields: [uploadId], references: [id])
  orderNumber String @unique
  platform    String
  merchantId  String
  merchantName String @default("")
  city        String
  bdName      String
  uploadedAt  DateTime @default(now())
  dishPrice Float
  packagingFee Float
  platformRedPacket Float
  originalDeliveryFee Float
  deliveryFeeReduction Float
  paidDeliveryFee Float
  merchantSettlementAmount Float
  userPaidAmount Float
  otherPromotion Float
  technicalServiceFee Float
  deliveryServiceFee Float
  merchantRate Float
}

model RecognitionFailure {
  id        String @id @default(cuid())
  uploadId  String @unique
  upload    Upload @relation(fields: [uploadId], references: [id])
  reason    String
  createdAt DateTime @default(now())
}
